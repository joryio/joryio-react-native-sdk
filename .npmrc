# npm only (pnpm, which the monorepo uses, ignores this setting).
#
# react and react-native are PEER dependencies: the host app supplies them.
# npm 7+ installs peers automatically, and resolves react-native to its latest
# release, whose optional @types/react peer (^19) conflicts with the
# @types/react ^18 this package type-checks against - so `npm install` (and
# with it `prepare`, which builds lib/) failed with ERESOLVE in a clean clone.
# The build needs no react-native runtime: its types come from the
# @types/react-native dev dependency.
legacy-peer-deps=true
