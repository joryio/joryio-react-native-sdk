{
  "name": "@joryio/react-native-sdk",
  "version": "1.3.2-beta.1",
  "description": "Joryio SDK for React Native - bridges native iOS and Android SDKs",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib/",
    "!lib/**/*.tsbuildinfo",
    "src/",
    "ios/**/*.{h,m,mm,swift}",
    "android/build.gradle",
    "android/src/main/",
    "joryio-react-native.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typescript": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "react-native",
    "joryio",
    "marketing",
    "analytics",
    "push-notifications",
    "in-app-messaging"
  ],
  "author": "Joryio",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://docs.joryio.com/developers/sdk/react-native-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/joryio/joryio-react-native-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/joryio/joryio-react-native-sdk/issues",
    "email": "support@joryio.com"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.75.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
